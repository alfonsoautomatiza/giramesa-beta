{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wertyMSD.github.io/giramesa-beta/release/release-manifest.schema.json",
  "title": "Giramesa public release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "android", "ios", "releaseNotes"],
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "android": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset", "sha256"],
      "properties": {
        "asset": {
          "type": "string",
          "pattern": "^giramesa-[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\.apk$"
        },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    },
    "ios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testFlightUrl", "version"],
      "properties": {
        "testFlightUrl": {
          "type": "string",
          "pattern": "^(|https://testflight\\.apple\\.com/join/[A-Za-z0-9]+)$"
        },
        "version": { "type": "string" }
      }
    },
    "releaseNotes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    }
  }
}
